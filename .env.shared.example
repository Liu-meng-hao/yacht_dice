# ========================================
# 快艇骰子游戏 - 共享数据库配置模板
# ========================================
# 此配置用于团队通过局域网共享同一个数据库
# 复制此文件为 .env.shared 并修改为实际配置
# ========================================

# 环境类型
ENVIRONMENT=development

# ========================================
# MySQL 配置（共享数据库）
# ========================================
# 修改为主机（数据库所在电脑）的局域网IP
MYSQL_HOST=192.168.21.15        # 例如: 192.168.1.100
MYSQL_PORT=3306
MYSQL_USER=yacht_user          # 建议创建专用数据库用户
MYSQL_PASSWORD=123456  # 设置团队共享的密码
MYSQL_DB=yacht_dice

# ========================================
# Redis 配置（共享Redis）
# ========================================
# 如果也共享Redis，同样修改为主机IP
REDIS_HOST=192.168.21.15         # 与MySQL主机相同或另一台
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========================================
# 应用安全配置
# ========================================
SECRET_KEY=your-shared-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ========================================
# 服务配置
# ========================================
WEBSOCKET_PORT=8000
PROJECT_NAME=快艇骰子游戏后端
PROJECT_VERSION=1.0.0
